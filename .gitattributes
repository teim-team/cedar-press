# Generated text is byte-compared by make check-generated on every OS.
# Keep only these declared outputs LF; do not renormalize the data tree.
docs/DATASET_CODEBOOK.md text eol=lf
docs/guides/*.md text eol=lf
index.html text eol=lf
public/sitemap.xml text eol=lf

# Served proof and sample hashes cover exact bytes, including line endings.
data/cedar/samples/*/*.csv -text
public/data/cedar/downloads/*.csv -text
data/cedar/need-reviewed-preview.json -text
data/cedar/verified-preview-releases.json -text
data/cedar/field_map.json -text
server/tests/fixtures/legacy-preview/** -text
data/cedar/preview_definition_overrides.json text eol=lf

# Sent to the host over SSM; CRLF would break bash.
infra/deploy.sh text eol=lf
