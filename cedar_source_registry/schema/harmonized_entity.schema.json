{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://cedar.press/schema/harmonized_entity.schema.json",
 "title": "Cedar harmonized entity (Layer 2: one resolved business, a view over Layer-1 records)",
 "type": "object",
 "required": [
  "entity_id",
  "entity_status",
  "canonical_name",
  "identity_assertions",
  "native_ownership_status",
  "source_record_ids",
  "field_provenance",
  "resolution_run_id",
  "first_seen",
  "last_seen",
  "review_status"
 ],
 "additionalProperties": false,
 "properties": {
  "entity_id": {
   "type": "string",
   "description": "Stable canonical Cedar entity id. Never reused; merges retire ids via merged_into."
  },
  "entity_status": {
   "type": "string",
   "enum": [
    "active",
    "dormant",
    "unresolved",
    "merged",
    "retired"
   ]
  },
  "merged_into": {
   "type": [
    "string",
    "null"
   ],
   "description": "entity_id this record was merged into, when entity_status=merged."
  },
  "canonical_name": {
   "type": "string",
   "description": "Selected by precedence-then-recency; provenance in field_provenance.canonical_name."
  },
  "name_variants": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "All distinct raw names across contributing records."
  },
  "dba_names": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "identity_assertions": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "business_source_id",
     "source_id",
     "source_priority_class",
     "identity_scope",
     "verification_basis",
     "as_of"
    ],
    "additionalProperties": false,
    "properties": {
     "business_source_id": {
      "type": "string"
     },
     "source_id": {
      "type": "string",
      "pattern": "^TBD-\\d{3}$"
     },
     "source_priority_class": {
      "type": "string",
      "enum": [
       "tribal_primary",
       "tribal_secondary",
       "tribal_partnership",
       "cross_reference",
       "discovery_only",
       "coverage_frame"
      ]
     },
     "identity_scope": {
      "type": "string",
      "enum": [
       "citizen",
       "descendant",
       "any_native",
       "tribal_government",
       "family_owned",
       "shareholder",
       "shareholder_descendant",
       "shareholder_spouse_descendant",
       "mixed",
       "unknown"
      ]
     },
     "relationship_basis": {
      "type": [
       "string",
       "null"
      ],
      "enum": [
       "citizen",
       "member",
       "descendant",
       "shareholder",
       "spouse",
       "family",
       "operated_by",
       "other",
       "unspecified",
       null
      ]
     },
     "tribal_affiliation_raw": {
      "type": [
       "string",
       "null"
      ]
     },
     "identity_claim_text": {
      "type": "string"
     },
     "verification_basis": {
      "type": "string"
     },
     "ownership_percent": {
      "type": [
       "number",
       "null"
      ]
     },
     "assertion_precedence_rank": {
      "type": [
       "integer",
       "null"
      ]
     },
     "as_of": {
      "type": "string",
      "format": "date-time",
      "description": "last_seen of the underlying record."
     },
     "is_current": {
      "type": [
       "boolean",
       "null"
      ]
     }
    }
   },
   "description": "One object per contributing identity claim. Never collapsed."
  },
  "controlling_assertion_id": {
   "type": [
    "string",
    "null"
   ],
   "description": "business_source_id of the assertion that controls under the precedence rules."
  },
  "native_ownership_status": {
   "type": "string",
   "enum": [
    "tribal_primary_asserted",
    "tribal_secondary_asserted",
    "cross_reference_only",
    "relationship_not_ownership",
    "conflicting",
    "unknown"
   ],
   "description": "Derived strictly from the controlling assertion's priority class. There is deliberately no boolean."
  },
  "nations": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "nation_id",
     "relationship",
     "evidence_business_source_ids"
    ],
    "additionalProperties": false,
    "properties": {
     "nation_id": {
      "type": "string"
     },
     "nation_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "relationship": {
      "type": "string",
      "enum": [
       "citizen",
       "descendant",
       "shareholder",
       "spouse",
       "operated_by",
       "asserted_unspecified"
      ]
     },
     "evidence_business_source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     }
    }
   },
   "description": "Edges to canonical nations. Certifying tribe and affiliation tribe are different facts."
  },
  "certifications": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "certifying_source_id",
     "is_current"
    ],
    "additionalProperties": false,
    "properties": {
     "certifying_source_id": {
      "type": "string",
      "pattern": "^TBD-\\d{3}$"
     },
     "certification_number": {
      "type": [
       "string",
       "null"
      ]
     },
     "certification_tier": {
      "type": [
       "string",
       "null"
      ]
     },
     "certification_start": {
      "type": [
       "string",
       "null"
      ],
      "format": "date"
     },
     "certification_expiration": {
      "type": [
       "string",
       "null"
      ],
      "format": "date"
     },
     "certification_event_status": {
      "type": [
       "string",
       "null"
      ]
     },
     "is_current": {
      "type": [
       "boolean",
       "null"
      ]
     }
    }
   },
   "description": "One object per certifying source; never merged across certifiers."
  },
  "naics": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "service_categories": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "description": {
   "type": [
    "string",
    "null"
   ]
  },
  "address": {
   "type": [
    "string",
    "null"
   ]
  },
  "city": {
   "type": [
    "string",
    "null"
   ]
  },
  "state_province": {
   "type": [
    "string",
    "null"
   ]
  },
  "postal_code": {
   "type": [
    "string",
    "null"
   ]
  },
  "phone": {
   "type": [
    "string",
    "null"
   ]
  },
  "email": {
   "type": [
    "string",
    "null"
   ]
  },
  "website": {
   "type": [
    "string",
    "null"
   ]
  },
  "field_provenance": {
   "type": "object",
   "additionalProperties": {
    "type": "string"
   },
   "description": "Map of populated canonical field -> business_source_id that supplied it. A value without provenance is invalid."
  },
  "source_record_ids": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   },
   "description": "Every contributing Layer-1 business_source_id."
  },
  "match_edges": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "left",
     "right",
     "method",
     "confidence",
     "run_id"
    ],
    "additionalProperties": false,
    "properties": {
     "left": {
      "type": "string"
     },
     "right": {
      "type": "string"
     },
     "method": {
      "type": "string",
      "enum": [
       "certification_number",
       "exact_name_address",
       "exact_website",
       "phone_email",
       "fuzzy_name_location",
       "manual"
      ]
     },
     "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
     },
     "run_id": {
      "type": "string"
     },
     "reviewed_by": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "description": "Accepted linkage decisions; confidence measures linkage, never ownership."
  },
  "conflicts": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "field",
     "assertions",
     "status"
    ],
    "additionalProperties": false,
    "properties": {
     "field": {
      "type": "string"
     },
     "assertions": {
      "type": "array",
      "minItems": 2,
      "items": {
       "type": "object",
       "required": [
        "business_source_id",
        "value"
       ],
       "properties": {
        "business_source_id": {
         "type": "string"
        },
        "value": {},
        "assertion_precedence_rank": {
         "type": [
          "integer",
          "null"
         ]
        }
       }
      }
     },
     "status": {
      "type": "string",
      "enum": [
       "open",
       "resolved"
      ]
     },
     "resolution_note": {
      "type": [
       "string",
       "null"
      ]
     }
    }
   },
   "description": "Disagreements persist here (matching rule 5); resolution never deletes Layer-1 rows."
  },
  "is_current": {
   "type": [
    "boolean",
    "null"
   ],
   "description": "True if any contributing assertion is current."
  },
  "validation_flags": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "review_status": {
   "type": "string",
   "enum": [
    "unreviewed",
    "machine_resolved",
    "human_reviewed"
   ]
  },
  "resolution_run_id": {
   "type": "string"
  },
  "first_seen": {
   "type": "string",
   "format": "date-time"
  },
  "last_seen": {
   "type": "string",
   "format": "date-time"
  },
  "notes": {
   "type": [
    "string",
    "null"
   ]
  }
 }
}