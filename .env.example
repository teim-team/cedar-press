# Cedar Press configuration. Every value is optional: with none of them set,
# the client runs standalone against its bundled catalog.

# The Cedar platform API. Setting this connects the deployment: sessions, the
# catalog, releases, downloads, activation and Cedar's answers all come from
# it, and the database behind it is the source of truth.
# VITE_API_URL=https://api.lumecon.ai

# The standalone preview account, and ONLY the standalone one: with
# VITE_API_URL set this is ignored entirely and the platform's session takes
# over. A JSON object of email -> { salt, hash, tier }, a shape of its own
# (the API's CEDAR_PRESS_ACCOUNTS records carry a PBKDF2 `password`
# instead), where `hash` is the lowercase hex SHA-256 of
# "<salt>:<password>". Generate one with
#
#     node scripts/press-demo-account.mjs reviewer@example.org press_pro
#
# Unset by default, and a build with none signs nobody in. Understand what
# this is before setting it: a static site cannot authenticate, so the check
# runs in the reader's browser against a digest that ships in a public
# bundle. It is a demonstration gate, it protects nothing behind it, and it
# is only acceptable because nothing behind it is confidential. The full
# reasoning is in src/features/grove/pressDemoGate.js.
# VITE_PRESS_DEMO_ACCOUNTS=

# Where "open the platform" links go.
# VITE_APP_URL=https://lumecon.ai

# Datadog RUM. Telemetry stays off unless both the application id and the
# client token are set, so preview builds report nothing.
# VITE_DATADOG_APPLICATION_ID=
# VITE_DATADOG_CLIENT_TOKEN=
# VITE_DATADOG_SITE=datadoghq.com
# VITE_DATADOG_SERVICE=cedar-press
# VITE_DATADOG_ENV=production
# VITE_DATADOG_SAMPLE_RATE=100
# VITE_DATADOG_REPLAY_SAMPLE_RATE=0
# VITE_APP_VERSION=

# ── Client addresses for rate limiting (API only) ───────────────────────
# Sign-in and activation are limited per client address. Behind CloudFront
# (the intended deployment once the API is activated, docs/HOSTNAMES.md) set TRUST_PROXY=1: the
# client is then the address CloudFront appended to X-Forwarded-For, counted
# PROXY_HOPS entries from the right, and anything a caller wrote to the left
# of it is ignored. Use PROXY_HOPS=2 if a load balancer sits behind
# CloudFront. 0 means clients connect directly. Must be set explicitly in
# staging and production; see server/README.md.
# CEDAR_PRESS_TRUST_PROXY=1
# CEDAR_PRESS_PROXY_HOPS=1

# ── Cedar ────────────────────────────────────────────────────────────────
# Read by the API in server/, not by the browser, so these have no VITE_
# prefix and never reach the bundle. The names and the CEDAR_ENABLED
# semantics match teim-app (teim-app/server/cedar/client.js). The chat path
# default is the Press route, /api/v1/press/messages.
#
# Unset, Cedar Press still answers what a collection holds, how it was built
# and its published figures, from the collection's own release. What needs
# these is everything past that.

# Where the cedar service is reachable. Unset disables the second answerer.
# CEDAR_BASE_URL=https://cedar.lumecon.ai

# The bearer token cedar/api/deps.require_internal_key checks.
# CEDAR_API_KEY is read as a fallback, as it is in teim-app.
# CEDAR_INTERNAL_API_KEY=

# Off only for the literal "false". Unset means on.
# CEDAR_ENABLED=

# Overrides for the endpoint and how long a reader waits. Defaults:
# /api/v1/press/messages, and 45000. Shorter than teim-app's 120000, because a
# reader is watching this panel rather than a background job.
# CEDAR_API_PATH=/api/v1/press/messages
# CEDAR_TIMEOUT_MS=45000

# ── Sign-in and sessions (API only) ─────────────────────────────────────
# Server-only, like everything below. Each one's meaning and format is in
# server/README.md, "Running it". With no accounts set, the API signs nobody in.
# CEDAR_PRESS_SECRET=
# CEDAR_PRESS_ACCOUNTS=
# CEDAR_PRESS_CODES=
# CEDAR_PRESS_ORIGINS=http://localhost:5173,https://cedarpress.ai,https://app.cedarpress.ai
# CEDAR_PRESS_INSECURE_COOKIE=

# ── Storage (API only) ──────────────────────────────────────────────────
# Postgres for subscribers and access codes, with its connection pool size
# (server/README.md, "Where the database goes").
# DATABASE_URL=
# CEDAR_PRESS_DB_POOL=8
# The SQLite file for the Cedar Points ledger; in memory when unset
# (server/README.md, "Shape the Research").
# CEDAR_PRESS_DB=

# ── Environment and pinned releases (API only) ──────────────────────────
# See server/README.md, "Pinned governed release downloads" and "Giving and
# PLOT component releases".
# CEDAR_PRESS_ENVIRONMENT=development
# CEDAR_PRESS_RELEASE_CATALOG=
# CEDAR_PRESS_DATA_API=
# CEDAR_PRESS_DATA_TOKEN=
# CEDAR_PRESS_DATA_TIMEOUT_SECONDS=30
# CEDAR_PRESS_COMPONENT_RELEASE_CATALOG=
# CEDAR_PRESS_COMPONENT_RELEASE_PIN=
# CEDAR_PRESS_RESEARCH_CATALOG=
# Rehearsal and review switches; production refuses all three:
# CEDAR_PRESS_PARTITIONED_REHEARSAL=
# CEDAR_GROVE_ENVIRONMENT=
# LUMECON_ENVIRONMENT=

# The private directory where `python -m cedar_press.grove_exchange` writes
# completed downloads for Cedar Grove (README.md, "The service").
# CEDAR_GROVE_EXCHANGE_DIRECTORY=

# Optional server-side Gaming release pin and catalog files. They use the same
# manifest, component rights and environment checks as the tracked default pin.
# Leave unset until a reviewed release is configured. Review mode remains
# prohibited when CEDAR_PRESS_ENVIRONMENT=production.
# CEDAR_GROVE_RELEASE_PIN=
# CEDAR_GROVE_RELEASE_CATALOG=

# ── Build and test (not read by the app) ────────────────────────────────
# PRESS_BUILD_SHA: the commit the build records; defaults to git's (vite.config.js).
# CEDAR_PRESS_SMOKE_PORT: the smoke suite's server port (playwright.config.js).
# CEDAR_PRESS_PRERENDER_PORT, CEDAR_BROWSER_CHANNEL: the prerender step's port
# and Chromium channel (scripts/prerender.mjs).
