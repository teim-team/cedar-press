{
  "name": "cedar-press",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "test": "npm run test:coverage",
    "test:coverage": "node scripts/coverage-gate.mjs",
    "build": "vite build && cp dist-site/index.html dist-site/404.html",
    "preview": "vite preview",
    "test:smoke": "playwright test",
    "prerender": "node scripts/prerender.mjs",
    "build:site": "npm run build && npm run prerender",
    "seo:check": "node scripts/seo-head.mjs --check",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@datadog/browser-rum": "^7.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "vite": "^8.3.0"
  }
}
